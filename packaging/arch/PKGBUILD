# Maintainer: cptn-cosmo <https://github.com/cptn-cosmo>

pkgname=kanzi
pkgver=0.6.0
pkgrel=1
pkgdesc='Modern, native Qt 6 / Wayland Apple Music and Plex client'
arch=('x86_64')
url='https://github.com/cptn-cosmo/kanzi'
license=('MIT')
depends=(
  'libgcc'
  'libstdc++'
  'glibc'
  'hicolor-icon-theme'
  'libpulse'
  'kwindowsystem'
  'qt6-base'
  'qt6-declarative'
  'qt6-wayland'  # runtime platform plugin, not linked
  'qt6-webchannel'
  'qt6-webengine'
)
makedepends=('cmake' 'ninja')
optdepends=(
  'widevine: Widevine CDM required for playback (AUR)'
  'google-chrome: alternative source of the Widevine CDM (AUR)'
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('ba1c9c113ee7a59291075475c04af985d110e76f41d836bd13a4b205a29837b3')

build() {
  cmake -S "$pkgname-$pkgver" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -Wno-dev
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 "$pkgname-$pkgver/LICENSE" -t "$pkgdir/usr/share/licenses/$pkgname/"
}
